exports[`risk-panel header — small-screen visual regression > position > full markup snapshot 1`] = `"<div class="flex flex-row items-center justify-between gap-2 space-y-0"><div class="min-w-0"><div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-base"><span class="flex min-w-0 items-center gap-2"><svg class="h-4 w-4 shrink-0 text-primary"></svg><span class="truncate">Risk controls</span></span><div class="rounded-md border font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 border-transparent bg-secondary text-secondary-foreground hover:bg-secondary/80 inline-flex max-w-full shrink-0 items-center gap-1 whitespace-nowrap px-1.5 py-0.5 text-[10px] leading-none sm:px-2 sm:text-[11px]" title="Position trading: months-long holds with wider stops and slower turnover"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-timer h-3 w-3 shrink-0" aria-hidden="true"><line x1="10" x2="14" y1="2" y2="2"></line><line x1="12" x2="15" y1="14" y2="11"></line><circle cx="12" cy="14" r="8"></circle></svg><span class="sm:hidden">Position</span><span class="hidden sm:inline">Position Only</span></div></div><div>Position horizon (months) · Stop-loss 6% · Take-profit 12%</div></div><svg class="h-4 w-4 text-muted-foreground transition-transform"></svg></div>"`;

